# Local development: Gemini AI features are disabled if this is blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Vercel: connect the private Blob store to this project; Vercel sets this token automatically.
# BLOB_READ_WRITE_TOKEN=provided-by-vercel-storage
# Configure these in Vercel → Project → Settings → Environment Variables.
# CAMPUSFIND_ADMIN_PASSWORD=use-a-long-unique-password
# CAMPUSFIND_SESSION_SECRET=at-least-32-random-bytes-hex-encoded
