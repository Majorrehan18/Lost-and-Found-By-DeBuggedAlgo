# Local development: optional. Gemini AI features are disabled if this is blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Vercel deployment only: configure these in Vercel Project → Settings → Environment Variables.
# DATABASE_URL=your_neon_postgres_connection_string
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token
# CAMPUSFIND_ADMIN_PASSWORD=use_a_long_unique_password
# CAMPUSFIND_SESSION_SECRET=generate_at_least_32_random_bytes
